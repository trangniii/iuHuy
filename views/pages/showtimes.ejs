<h1>Danh Sách Suất Chiếu</h1>
<table>
  <thead>
    <tr>
      <th>Phim</th>
      <th>Phòng Chiếu</th>
      <th>Thời Gian Bắt Đầu</th>
      <th>Thời Gian Kết Thúc</th>
      <th>Thao Tác</th>
    </tr>
  </thead>
  <tbody>
    <% showtimes.forEach(showtime => { %>
    <tr>
      <td><%= showtime.movieTitle %></td>
      <td><%= showtime.hallName %></td>
      <td><%= showtime.startTime %></td>
      <td><%= showtime.endTime %></td>
      <td>
        <form action="/showtimes/delete/<%= showtime.id %>" method="POST">
          <button type="submit">Xóa</button>
        </form>
        <a href="/showtimes/update/<%= showtime.id %>">Cập Nhật</a>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>

<h2>Thêm Suất Chiếu Mới</h2>
<form action="/showtimes/add" method="POST">
  <label for="movieId">Phim:</label>
  <input type="text" name="movieId" id="movieId" required />
  <label for="cinemaHallId">Phòng Chiếu:</label>
  <input type="text" name="cinemaHallId" id="cinemaHallId" required />
  <label for="startTime">Thời Gian Bắt Đầu:</label>
  <input type="datetime-local" name="startTime" id="startTime" required />
  <label for="endTime">Thời Gian Kết Thúc:</label>
  <input type="datetime-local" name="endTime" id="endTime" required />
  <button type="submit">Thêm</button>
</form>
