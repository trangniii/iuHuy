<%- include('../components/images-slide', {
  images: imagesSlideshow
}) %>
<div class="container my-5 pb-2">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-2">
      <div class="rounded-circle bg-danger" style="width: 20px; height: 20px;"></div>
      <h3>Phim đang chiếu</h3>
    </div>
    <a href="#" class="text-secondary">Xem tất cả</a>
  </div>

  <div class="container text-center">

    <div class="row row-3 row-md-4 roww-lg-6 g-4">
      <% if (nowMovies.length === 0) { %>
      <div class="no-data text-center py-4">
        <i class="bi bi-emoji-frown" style="font-size: 2rem;"></i>
        <p>Không có phim nào đang chiếu</p>
      </div>
      <% } %>
      <% nowMovies.forEach(nowMovie => { %>
      <%- include('../components/movie-card', {movie: nowMovie}) %>
      <% }) %>
    </div>
  </div>
</div>

<div class="container my-5 pt-4 border-top border-top-5 border-top-primary">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-2">
      <div class="rounded-circle bg-danger" style="width: 20px; height: 20px;"></div>
      <h3>Phim sắp chiếu</h3>
    </div>
    <a href="#" class="text-secondary">Xem tất cả</a>
  </div>

  <div class="container text-center">

    <div class="row row-3 row-md-4 roww-lg-6 g-4">
      <% if (upComingMovies.length === 0) { %>
      <div class="no-data text-center py-4">
        <i class="bi bi-emoji-frown" style="font-size: 2rem;"></i>
        <p>Không có phim nào sắp chiếu chiếu</p>
      </div>
      <% } %>
      <% upComingMovies.forEach(movie => { %>

      <%- include('../components/movie-card', {movie}) %>
      <% }) %>
    </div>
  </div>
</div>