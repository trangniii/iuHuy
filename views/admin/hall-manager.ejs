<div class="container pt-4">
  <h2>Quản lý phòng chiếu</h2>
  <div class="d-flex justify-content-end">
  <button type="button" data-bs-target="#hallsModal" data-bs-toggle="modal" class="btn btn-primary">Thêm phòng chiếu</button>
  </div>
  <table class="table table-hover">
    <thead>
      <tr class="text-center">
        <th scope="col">#</th>
        <th scope="col">Tên</th>
        <th scope="col">Số hàng ghế</th>
        <th scope="col">Số cột ghế</th>
        <th scope="col"></th>
      </tr>
    </thead>
    <tbody>
      <% if (halls.length === 0) { %>
      <tr>
        <td colspan="5" class="text-center" >Không có phòng chiếu nào</td>
      </tr>
      <% } %>
     <% halls.forEach((hall) => { %>
      <tr>
        <th scope="row"><%= hall.id %></th>
        <td><%= hall.name %></td>
        <td><%= hall.seatRows %></td>
        <td><%= hall.seatColumns %></td>
      </tr> 
     <% }) %> 
    </tbody>
  </table>

<!-- Modal -->
<div class="modal fade" id="hallsModal" tabindex="-1" aria-labelledby="hallsModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5 js--title" id="hallsModalLabel">Modal title</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="halls-form" class="needs-validation" novalidate>
          <div class="form-group mb-1">
              <label for="roomName" class="mb-2" >Tên phòng chiếu</label>
              <input type="text" class="form-control" id="roomName" placeholder="Nhập tên phòng chiếu" required>
              <div class="invalid-feedback">
                  Vui lòng nhập tên phòng chiếu.
              </div>
          </div>
          <div class="form-group mb-1">
              <label for="rowNumber" class="mb-2">Số hàng ghế</label>
              <input type="number" class="form-control" id="rowNumber" placeholder="Nhập số hàng ghế" min="1" required>
              <div class="invalid-feedback">
                  Vui lòng nhập số hàng ghế hợp lệ (tối thiểu là 1).
              </div>
          </div>
          <div class="form-group">
              <label for="columnNumber" class="mb-2" >Số cột ghế</label>
              <input type="number" class="form-control" id="columnNumber" placeholder="Nhập số cột ghế" min="1" required>
              <div class="invalid-feedback">
                  Vui lòng nhập số cột ghế hợp lệ (tối thiểu là 1).
              </div>
          </div>
      </form>
      </div>
      <div class="modal-footer">
        <button type="submit" form="halls-form" class="btn btn-primary">Lưu</button>
      </div>
    </div>
  </div>
</div>

</div>