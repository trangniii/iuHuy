<header class=" position-fixed z-3 top-0 start-0 end-0 bg-body-tertiary">
  <nav class="navbar container navbar-expand-lg  ">
    <div class="container-fluid">
      <a class="navbar-brand" href="/"><img src="/images/logo.png" alt="image"></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="/">Trang chủ</a>
          </li>
          <% if (locals?.user?.role === UserRole.ADMIN ) { %>
          <li class="nav-item">
            <div class="dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                Admin
              </a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="<%= MoviePaths.DASHBOARD %>">Dashboard</a></li>
                <li><a class="dropdown-item" href="<%= MoviePaths.ADMIN_HALLS %>">Quản lý phòng chiếu</a></li>
                <li><a class="dropdown-item" href="<%= MoviePaths.ADMIN_MANAGEMENT %>">Quản lý phim</a></li>
              </ul>
            </div>
          </li>
          <% } %>
        </ul>

        <% if (locals?.user) { %>
        <div class="dropdown">
          <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <%= user.username %>
          </button>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="#">Vé đã đặt</a></li>
            <li><a class="dropdown-item" href="<%= MoviePaths.LOGOUT %>">Đăng xuất</a></li>
          </ul>
        </div>
        <% } else { %>
        <a href="<%= MoviePaths.LOGIN %>" class="btn mx-2 btn-primary">Đăng nhập</a>
        <a href="<%= MoviePaths.REGISTER %>" class="btn btn-outline-primary">Đăng ký</a>
        <% } %>
      </div>
    </div>
  </nav>
</header>